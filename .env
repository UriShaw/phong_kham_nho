# Biến môi trường hệ thống MedPro
# Cấu hình database MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=medpro_db

# Cấu hình Flask
SECRET_KEY=medpro_secret_key_2024_very_secure_change_this
FLASK_ENV=development
FLASK_DEBUG=1

# Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Thanh toán MB Bank
MBBANK_STK=0965117393
MBBANK_TEN=NGUYEN QUOC ANH
MBBANK_BANK_ID=MB

# SMTP Email - Gửi nhắc thuốc qua Gmail
# Bước 1: Bật xác minh 2 bước: https://myaccount.google.com/signinoptions/two-step-verification
# Bước 2: Tạo App Password: https://myaccount.google.com/apppasswords
#         Chọn "Mail" → Copy mật khẩu 16 ký tự (không có dấu cách)
# Bước 3: Điền email Gmail và App Password vào đây
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
